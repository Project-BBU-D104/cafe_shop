{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "laravel-boost": {
        "type": "local",
        "command": ["php", "laravel_api/artisan", "boost:mcp"]
      },
      "dart": {
        "type": "local",
        "command": ["dart", "mcp-server"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      }
    }
  }
}
